# Server
HOST=0.0.0.0
PORT=8082

# Upstream Responses API endpoint (set full endpoint URL, not just base domain)
UPSTREAM_RESPONSES_API_URL=https://api.openai.com/v1/responses
UPSTREAM_API_KEY=sk-your-upstream-api-key
# Upstream auth header mode: authorization | x-api-key
UPSTREAM_API_KEY_HEADER=authorization

# Relay auth (API key for clients)
RELAY_API_KEY=change-me-to-a-long-random-string

# Optional reasoning override for Responses API requests.
# Leave REASONING_MODELS empty to apply to all models.
# Set REASONING_OVERRIDE=true to replace reasoning sent by Cursor.
# REASONING_EFFORT=minimal
# REASONING_EFFORT=low
# REASONING_EFFORT=medium
# REASONING_EFFORT=high
REASONING_EFFORT=
REASONING_MODELS=
REASONING_OVERRIDE=false

# Logging & Dashboard
LOG_BODY_LIMIT=2000000
LOG_STORE_LIMIT=20
LOG_FILE=logs/requests.jsonl
DASHBOARD_ENABLED=true
DASHBOARD_TITLE=BYOK Relay Logs
